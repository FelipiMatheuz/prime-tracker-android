{
  "rules": {
    ".read": false,
    ".write": false,

    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['userId', 'nickname', 'platform', 'region'])",
        "userId": {
          ".validate": "newData.val() === auth.uid"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "platform": {
          ".validate": "newData.isString() && (newData.val() === 'PC' || newData.val() === 'PLAYSTATION' || newData.val() === 'XBOX' || newData.val() === 'NINTENDO_SWITCH' || newData.val() === 'CROSSPLAY')"
        },
        "region": {
          ".validate": "newData.isString() && (newData.val() === 'NORTH_AMERICA' || newData.val() === 'SOUTH_AMERICA' || newData.val() === 'EUROPE' || newData.val() === 'ASIA' || newData.val() === 'OCEANIA' || newData.val() === 'MIDDLE_EAST')"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "announcements": {
      ".read": "auth != null",
      ".indexOn": ["targetId", "platform", "region", "expiresAt"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['userId', 'targetId', 'nickname', 'platform', 'region', 'createdAt', 'expiresAt'])",
        "userId": {
          ".validate": "newData.val() === auth.uid"
        },
        "targetId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "platform": {
          ".validate": "newData.isString() && (newData.val() === 'PC' || newData.val() === 'PLAYSTATION' || newData.val() === 'XBOX' || newData.val() === 'NINTENDO_SWITCH' || newData.val() === 'CROSSPLAY')"
        },
        "region": {
          ".validate": "newData.isString() && (newData.val() === 'NORTH_AMERICA' || newData.val() === 'SOUTH_AMERICA' || newData.val() === 'EUROPE' || newData.val() === 'ASIA' || newData.val() === 'OCEANIA' || newData.val() === 'MIDDLE_EAST')"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() <= now)"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 310000"
        },
        "note": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
