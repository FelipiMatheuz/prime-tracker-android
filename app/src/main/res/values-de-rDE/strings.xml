    <!-- Help -->
    <string name="help_tip">Tipp</string>
    <string name="help_gs_title">Erste Schritte</string>
    <string name="help_gs_desc">Prime Tracker hilft dir, deine Prime-Kollektion zu organisieren, dein Inventar zu verfolgen und deine Farming-Ziele zu planen.\n\nAlles wird standardmäßig lokal gespeichert.\nDas Cloud-Backup ist optional.</string>
    <string name="help_gs_tip">Das Inventar speichert, was du besitzt.\nZiele helfen dir zu planen, was du möchtest.</string>
    <string name="help_ps_title">Prime Sets</string>
    <string name="help_ps_desc">Prime Sets sind das Herzstück von Prime Tracker.\n\nJedes Prime Set wird automatisch entsprechend der in deinem Inventar verfügbaren Prime Teile vervollständigt.</string>
    <string name="help_ps_inv_title">Inventar</string>
    <string name="help_ps_inv_desc">Das Inventar speichert jedes Prime Teil, das du besitzt.\n\nDas Aktualisieren deines Inventars aktualisiert sofort den Kollektionsfortschritt in der gesamten Anwendung.</string>
    <string name="help_ps_inv_tip">Nutze das Inventar, um eigene Teile zu registrieren.\nDie Vervollständigung wird automatisch berechnet.</string>
    <string name="help_relics_title">Relikte</string>
    <string name="help_relics_desc">Durchsuche jedes im Spiel verfügbare Relikt.\n\nJedes Relikt zeigt seine Drop-Tabelle, Verfügbarkeit und Erwerbsquelle an.</string>
    <string name="help_relics_av_title">Verfügbarkeit</string>
    <string name="help_relics_av_desc">Relikte können wie folgt verfügbar sein:\n\nAktiv - Im Vault - Prime Resurgence - Baro Ki\'Teer</string>
    <string name="help_relics_av_tip">Nutze Filter, um schnell bestimmte Relikte oder Prime Teile zu finden.</string>
    <string name="help_goals_title">Ziele</string>
    <string name="help_goals_desc">Ziele helfen, deine Farming-Pläne, Erinnerungen und Handelsziele zu organisieren.\n\nZiele verbrauchen niemals automatisch das Inventar.</string>
    <string name="help_goals_tags_title">Tags</string>
    <string name="help_goals_tags_desc">Organisiere Ziele mit benutzerdefinierten Tags wie:\n\nFarmen - Handel - Dukaten</string>
    <string name="help_goals_tags_tip">Nutze Ziele zur Planung.\nNutze das Inventar, um Gegenstände darzustellen, die du bereits besitzt.</string>
    <string name="help_cloud_title">Cloud-Backup</string>
    <string name="help_cloud_desc">Cloud-Backup speichert nur deinen persönlichen Fortschritt.\n\nDu kannst dein Inventar und deine Ziele jederzeit hoch- oder herunterladen.</string>
    <string name="help_cloud_legacy_title">Legacy-Migration</string>
    <string name="help_cloud_legacy_desc">Legacy-Migration importiert deine vorherige Checkliste in das neue Inventarsystem.\n\nNach einer erfolgreichen Migration werden die alten Daten dauerhaft aus dem Cloud-Backup entfernt.</string>
    <string name="help_cloud_legacy_tip">Spieldaten und persönliche Daten werden unabhängig voneinander synchronisiert.</string>
    <string name="help_faq_title">FAQ</string>
    <string name="help_faq_q1">Kann ich Prime Tracker offline nutzen?</string>
    <string name="help_faq_a1">Ja.\n\nAlle Anwendungsfunktionen funktionieren offline.\n\nCloud-Backup ist optional.</string>
    <string name="help_faq_q2">Warum verbraucht das Abschließen eines Ziels nicht das Inventar?</string>
    <string name="help_faq_a2">Ziele stellen die persönliche Planung dar.\n\nDas Inventar stellt die besessenen Gegenstände dar.\n\nBeide Systeme sind absichtlich unabhängig voneinander.</string>
    <string name="help_faq_q3">Wie wird die Prime Set Vervollständigung berechnet?</string>
    <string name="help_faq_a3">Die Vervollständigung wird automatisch aus den in deinem Inventar registrierten Prime Teilen berechnet.</string>
    <string name="help_faq_q4">Was wird im Cloud-Backup gespeichert?</string>
    <string name="help_faq_a4">Nur persönliche Daten:\n\nInventar\n\nZiele\n\nAnwendungseinstellungen</string>
    <string name="help_faq_q5">Kann ich meine alte Checkliste migrieren?</string>
    <string name="help_faq_a5">Ja.\n\nNutze die Legacy-Migration im Cloud-Backup-Bildschirm.\n\nWARNUNG: Diese Funktion wird mit fortschreitender Version entfernt.</string>

