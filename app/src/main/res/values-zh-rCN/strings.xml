    <!-- Help -->
    <string name="help_tip">提示</string>
    <string name="help_gs_title">入门指南</string>
    <string name="help_gs_desc">Prime Tracker 帮助你组织 Prime 珍藏、追踪库存并规划刷取目标。\n\n默认情况下，所有内容都存储在本地。\n云端备份是可选的。</string>
    <string name="help_gs_tip">库存存储你已拥有的物品。\n目标帮助你规划你想要的物品。</string>
    <string name="help_ps_title">Prime 套装</string>
    <string name="help_ps_desc">Prime 套装是 Prime Tracker 的核心。\n\n每个 Prime 套装会根据你库存中可用的 Prime 部件自动完成。</string>
    <string name="help_ps_inv_title">库存</string>
    <string name="help_ps_inv_desc">库存存储你拥有的每一个 Prime 部件。\n\n更新你的库存会立即更新整个应用的珍藏进度。</string>
    <string name="help_ps_inv_tip">使用库存来登记已拥有的部件。\n完成度是自动计算的。</string>
    <string name="help_relics_title">虚空遗物</string>
    <string name="help_relics_desc">浏览游戏中可用的每一个虚空遗物。\n\n每个虚空遗物都会显示其掉落表、可用性和获取来源。</string>
    <string name="help_relics_av_title">可用性</string>
    <string name="help_relics_av_desc">虚空遗物可以通过以下方式获得:\n\n活动 - 已入库 - Prime 复间 - 巴洛·基\'泰尔</string>
    <string name="help_relics_av_tip">使用筛选器快速定位特定的虚空遗物或 Prime 部件。</string>
    <string name="help_goals_title">目标</string>
    <string name="help_goals_desc">目标帮助组织你的刷取计划、提醒和交易目标。\n\n目标永远不会自动消耗库存。</string>
    <string name="help_goals_tags_title">标签</string>
    <string name="help_goals_tags_desc">使用自定义标签组织目标，例如:\n\n刷取 - 交易 - 杜卡德金币</string>
    <string name="help_goals_tags_tip">使用目标进行规划。\n使用库存表示你已经拥有的物品。</string>
    <string name="help_cloud_title">云端备份</string>
    <string name="help_cloud_desc">云端备份仅存储你的个人进度。\n\n你可以随时上传或下载你的库存和目标。</string>
    <string name="help_cloud_legacy_title">旧版本迁移</string>
    <string name="help_cloud_legacy_desc">旧版本迁移会将你之前的清单导入新的库存系统。\n\n迁移成功后，旧数据将永久从云端备份中删除。</string>
    <string name="help_cloud_legacy_tip">游戏数据和个人数据是独立同步的。</string>
    <string name="help_faq_title">常见问题</string>
    <string name="help_faq_q1">我可以离线使用 Prime Tracker 吗？</string>
    <string name="help_faq_a1">可以。\n\n所有应用功能都支持离线使用。\n\n云端备份是可选的。</string>
    <string name="help_faq_q2">为什么完成目标不会消耗库存？</string>
    <string name="help_faq_a2">目标代表个人规划。\n\n库存代表已拥有的物品。\n\n这两个系统被有意设计为相互独立。 </string>
    <string name="help_faq_q3">Prime 套装完成度是如何计算的？</string>
    <string name="help_faq_a3">完成度是根据你库存中登记的 Prime 部件自动计算的。</string>
    <string name="help_faq_q4">云端备份中存储了什么？</string>
    <string name="help_faq_a4">仅限个人数据:\n\n库存\n\n目标\n\n应用偏好设置</string>
    <string name="help_faq_q5">我可以迁移旧的清单吗？</string>
    <string name="help_faq_a5">可以。\n\n在云端备份页面使用旧版本迁移。\n\n警告: 此功能将随版本进度被移除。</string>

