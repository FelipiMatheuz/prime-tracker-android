    <!-- Help -->
    <string name="help_tip">Dica</string>
    <string name="help_gs_title">Primeiros Passos</string>
    <string name="help_gs_desc">O Prime Tracker ajuda você a organizar sua coleção Prime, rastrear seu inventário e planejar seus objetivos de farm.\n\nTudo é armazenado localmente por padrão.\nO Backup na Nuvem é opcional.</string>
    <string name="help_gs_tip">O Inventário armazena o que você possui.\nOs Objetivos ajudam você a planejar o que deseja.</string>
    <string name="help_ps_title">Conjuntos Prime</string>
    <string name="help_ps_desc">Os Conjuntos Prime são o coração do Prime Tracker.\n\nCada Conjunto Prime é concluído automaticamente de acordo com as Partes Prime disponíveis em seu Inventário.</string>
    <string name="help_ps_inv_title">Inventário</string>
    <string name="help_ps_inv_desc">O Inventário armazena cada Parte Prime que você possui.\n\nAtualizar seu Inventário atualiza imediatamente o progresso da coleção em todo o aplicativo.</string>
    <string name="help_ps_inv_tip">Use o Inventário para registrar partes obtidas.\nA conclusão é calculada automaticamente.</string>
    <string name="help_relics_title">Relíquias</string>
    <string name="help_relics_desc">Navegue por todas as Relíquias disponíveis no jogo.\n\nCada Relíquia exibe sua tabela de drops, disponibilidade e fonte de obtenção.</string>
    <string name="help_relics_av_title">Disponibilidade</string>
    <string name="help_relics_av_desc">As Relíquias podem estar disponíveis através de:\n\nAtiva - No Cofre - Ressurgência Prime - Baro Ki\'Teer</string>
    <string name="help_relics_av_tip">Use filtros para localizar rapidamente Relíquias ou Partes Prime específicas.</string>
    <string name="help_goals_title">Objetivos</string>
    <string name="help_goals_desc">Os Objetivos ajudam a organizar seus planos de farm, lembretes e metas de trocas.\n\nOs Objetivos nunca consomem o Inventário automaticamente.</string>
    <string name="help_goals_tags_title">Etiquetas</string>
    <string name="help_goals_tags_desc">Organize seus Objetivos usando Etiquetas personalizadas como:\n\nFarm - Troca - Ducados</string>
    <string name="help_goals_tags_tip">Use Objetivos para planejamento.\nUse o Inventário para representar itens que você já possui.</string>
    <string name="help_cloud_title">Backup na Nuvem</string>
    <string name="help_cloud_desc">O Backup na Nuvem armazena apenas o seu progresso pessoal.\n\nVocê pode fazer upload ou download do seu Inventário e Objetivos a qualquer momento.</string>
    <string name="help_cloud_legacy_title">Migração de Legado</string>
    <string name="help_cloud_legacy_desc">A Migração de Legado importa seu checklist anterior para o novo sistema de Inventário.\n\nApós uma migração bem-sucedida, os dados legados são removidos permanentemente do Backup na Nuvem.</string>
    <string name="help_cloud_legacy_tip">Os dados do jogo e os dados pessoais são sincronizados de forma independente.</string>
    <string name="help_faq_title">Perguntas Frequentes</string>
    <string name="help_faq_q1">Posso usar o Prime Tracker offline?</string>
    <string name="help_faq_a1">Sim.\n\nTodos os recursos do aplicativo funcionam offline.\n\nO Backup na Nuvem é opcional.</string>
    <string name="help_faq_q2">Por que concluir um Objetivo não consome o Inventário?</string>
    <string name="help_faq_a2">Objetivos representam planejamento pessoal.\n\nO Inventário representa itens obtidos.\n\nAmbos os sistemas são intencionalmente independentes.</string>
    <string name="help_faq_q3">Como a conclusão do Conjunto Prime é calculada?</string>
    <string name="help_faq_a3">A conclusão é calculada automaticamente a partir das Partes Prime registradas em seu Inventário.</string>
    <string name="help_faq_q4">O que é armazenado no Backup na Nuvem?</string>
    <string name="help_faq_a4">Apenas dados pessoais:\n\nInventário\n\nObjetivos\n\nPreferências do aplicativo</string>
    <string name="help_faq_q5">Posso migrar meu checklist antigo?</string>
    <string name="help_faq_a5">Sim.\n\nUse a Migração de Legado dentro da tela de Backup na Nuvem.\n\nAviso: Este recurso será removido conforme o progresso da versão.</string>

