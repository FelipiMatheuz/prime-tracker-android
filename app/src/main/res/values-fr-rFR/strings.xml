    <!-- Help -->
    <string name="help_tip">Astuce</string>
    <string name="help_gs_title">Premiers pas</string>
    <string name="help_gs_desc">Prime Tracker vous aide à organiser votre collection Prime, à suivre votre inventaire et à planifier vos objectifs de farm.\n\nTout est stocké localement par défaut.\nLa sauvegarde Cloud est facultative.</string>
    <string name="help_gs_tip">L\'inventaire stocke ce que vous possédez.\nLes objectifs vous aident à planifier ce que vous voulez.</string>
    <string name="help_ps_title">Ensembles Prime</string>
    <string name="help_ps_desc">Les ensembles Prime sont le cœur de Prime Tracker.\n\nChaque ensemble Prime est automatiquement complété en fonction des pièces Prime disponibles dans votre inventaire.</string>
    <string name="help_ps_inv_title">Inventaire</string>
    <string name="help_ps_inv_desc">L\'inventaire stocke chaque pièce Prime que vous possédez.\n\nMettre à jour votre inventaire met immédiatement à jour la progression de la collection dans toute l\'application.</string>
    <string name="help_ps_inv_tip">Utilisez l\'inventaire pour enregistrer les pièces possédées.\nLa complétion est calculée automatiquement.</string>
    <string name="help_relics_title">Reliques</string>
    <string name="help_relics_desc">Parcourez chaque relique disponible dans le jeu.\n\nChaque relique affiche sa table de butin, sa disponibilité et sa source d\'acquisition.</string>
    <string name="help_relics_av_title">Disponibilité</string>
    <string name="help_relics_av_desc">Les reliques peuvent être disponibles via :\n\nActive - En Soute - Résurgence Prime - Baro Ki\'Teer</string>
    <string name="help_relics_av_tip">Utilisez les filtres pour localiser rapidement des reliques ou des pièces Prime spécifiques.</string>
    <string name="help_goals_title">Objectifs</string>
    <string name="help_goals_desc">Les objectifs aident à organiser vos plans de farm, rappels et objectifs d\'échange.\n\nLes objectifs ne consomment jamais l\'inventaire automatiquement.</string>
    <string name="help_goals_tags_title">Tags</string>
    <string name="help_goals_tags_desc">Organisez vos objectifs en utilisant des tags personnalisés tels que :\n\nFarm - Échange - Ducats</string>
    <string name="help_goals_tags_tip">Utilisez les objectifs pour la planification.\nUtilisez l\'inventaire pour représenter les objets que vous possédez déjà.</string>
    <string name="help_cloud_title">Sauvegarde Cloud</string>
    <string name="help_cloud_desc">La sauvegarde Cloud stocke uniquement votre progression personnelle.\n\nVous pouvez uploader ou télécharger votre inventaire et vos objectifs à tout moment.</string>
    <string name="help_cloud_legacy_title">Migration héritée</string>
    <string name="help_cloud_legacy_desc">La migration héritée importe votre ancienne liste dans le nouveau système d\'inventaire.\n\nAprès une migration réussie, les données héritées sont définitivement supprimées de la sauvegarde Cloud.</string>
    <string name="help_cloud_legacy_tip">Les données du jeu et les données personnelles sont synchronisées indépendamment.</string>
    <string name="help_faq_title">FAQ</string>
    <string name="help_faq_q1">Puis-je utiliser Prime Tracker hors ligne ?</string>
    <string name="help_faq_a1">Oui.\n\nToutes les fonctionnalités de l\'application fonctionnent hors ligne.\n\nLa sauvegarde Cloud est facultative.</string>
    <string name="help_faq_q2">Pourquoi terminer un objectif ne consomme-t-il pas l\'inventaire ?</string>
    <string name="help_faq_a2">Les objectifs représentent la planification personnelle.\n\nL\'inventaire représente les objets possédés.\n\nLes deux systèmes sont intentionnellement indépendants.</string>
    <string name="help_faq_q3">Comment la complétion des ensembles Prime est-elle calculée ?</string>
    <string name="help_faq_a3">La complétion est calculée automatiquement à partir des pièces Prime enregistrées dans votre inventaire.</string>
    <string name="help_faq_q4">Qu\'est-ce qui est stocké dans la sauvegarde Cloud ?</string>
    <string name="help_faq_a4">Uniquement les données personnelles :\n\nInventaire\n\nObjectifs\n\nPréférences de l\'application</string>
    <string name="help_faq_q5">Puis-je migrer mon ancienne liste ?</string>
    <string name="help_faq_a5">Oui.\n\nUtilisez la migration héritée sur l\'écran de sauvegarde Cloud.\n\nAVERTISSEMENT : Cette fonctionnalité sera supprimée au fil des versions.</string>

