    <!-- Help -->
    <string name="help_tip">Consejo</string>
    <string name="help_gs_title">Primeros pasos</string>
    <string name="help_gs_desc">Prime Tracker te ayuda a organizar tu colección Prime, rastrear tu inventario y planificar tus objetivos de farmeo.\n\nTodo se guarda localmente por defecto.\nLa copia de seguridad en la nube es opcional.</string>
    <string name="help_gs_tip">El inventario guarda lo que tienes.\nLos objetivos te ayudan a planificar lo que quieres.</string>
    <string name="help_ps_title">Conjuntos Prime</string>
    <string name="help_ps_desc">Los conjuntos Prime son el corazón de Prime Tracker.\n\nCada conjunto Prime se completa automáticamente según las partes Prime disponibles en tu inventario.</string>
    <string name="help_ps_inv_title">Inventario</string>
    <string name="help_ps_inv_desc">El inventario guarda cada parte Prime que posees.\n\nAl actualizar tu inventario se actualiza inmediatamente el progreso de la colección en toda la aplicación.</string>
    <string name="help_ps_inv_tip">Usa el inventario para registrar las partes que posees.\nEl progreso se calcula automáticamente.</string>
    <string name="help_relics_title">Reliquias</string>
    <string name="help_relics_desc">Explora cada reliquia disponible en el juego.\n\nCada reliquia muestra su tabla de hallazgos, disponibilidad y fuente de obtención.</string>
    <string name="help_relics_av_title">Disponibilidad</string>
    <string name="help_relics_av_desc">Las reliquias pueden estar disponibles a través de:\n\nActiva - En el Nexo - Resurgimiento Prime - Baro Ki\'Teer</string>
    <string name="help_relics_av_tip">Usa los filtros para localizar rápidamente reliquias o partes Prime específicas.</string>
    <string name="help_goals_title">Objetivos</string>
    <string name="help_goals_desc">Los objetivos ayudan a organizar tus planes de farmeo, recordatorios y metas de comercio.\n\nLos objetivos nunca consumen el inventario automáticamente.</string>
    <string name="help_goals_tags_title">Etiquetas</string>
    <string name="help_goals_tags_desc">Organiza los objetivos usando etiquetas personalizadas como:\n\nFarmeo - Comercio - Ducados</string>
    <string name="help_goals_tags_tip">Usa los objetivos para planificar.\nUsa el inventario para representar los objetos que ya posees.</string>
    <string name="help_cloud_title">Copia de seguridad en la nube</string>
    <string name="help_cloud_desc">La copia de seguridad en la nube solo guarda tu progreso personal.\n\nPuedes subir o descargar tu inventario y objetivos en cualquier momento.</string>
    <string name="help_cloud_legacy_title">Migración de legado</string>
    <string name="help_cloud_legacy_desc">La migración de legado importa tu lista de verificación anterior al nuevo sistema de inventario.\n\nTras una migración con éxito, los datos del legado se eliminan permanentemente de la copia de seguridad en la nube.</string>
    <string name="help_cloud_legacy_tip">Los datos del juego y los datos personales se sincronizan de forma independiente.</string>
    <string name="help_faq_title">Preguntas frecuentes</string>
    <string name="help_faq_q1">¿Puedo usar Prime Tracker sin conexión?</string>
    <string name="help_faq_a1">Sí.\n\nTodas las funciones de la aplicación funcionan sin conexión.\n\nLa copia de seguridad en la nube es opcional.</string>
    <string name="help_faq_q2">¿Por qué completar un objetivo no consume el inventario?</string>
    <string name="help_faq_a2">Los objetivos representan la planificación personal.\n\nEl inventario representa los objetos en propiedad.\n\nAmbos sistemas son independientes de forma intencionada.</string>
    <string name="help_faq_q3">¿Cómo se calcula el progreso del conjunto Prime?</string>
    <string name="help_faq_a3">El progreso se calcula automáticamente a partir de las partes Prime registradas en tu inventario.</string>
    <string name="help_faq_q4">¿Qué se guarda en la copia de seguridad en la nube?</string>
    <string name="help_faq_a4">Solo datos personales:\n\nInventario\n\nObjetivos\n\nPreferencias de la aplicación</string>
    <string name="help_faq_q5">¿Puedo migrar mi antigua lista de verificación?</string>
    <string name="help_faq_a5">Sí.\n\nUsa la migración de legado dentro de la pantalla de copia de seguridad en la nube.\n\nADVERTENCIA: Esta función se eliminará conforme avance la versión.</string>

