    <!-- Dialog Info -->
    <string name="help_content">%1$s:\n-Long press and slide left/right one of the items to check/uncheck (respectively) all items within the set
        \n-Click on one of the items to see details
        \n\tClick on a prime component to mark/unmark the item\n-Use the filter in the toolbar to ease your search
        \n\n%2$s:\n-Tap the arrow on one of the items to see details
        \n\tClick on a prime component to mark/unmark the item\n-Use the filter in the toolbar to ease your search
        \n\n%3$s:\n-Click on the relic to see the details
        \n-Disabled relics indicate that you already have all the primes that the relic offers
        \n-Enabled relics indicate that it contains items not yet obtained
        \n-The number next to the relic indicates how many prime items have not been obtained
        \n-Use the filter in the toolbar to ease your search</string>
